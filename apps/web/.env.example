# Copy to .env and fill in values:
#   cp .env.example .env
#
# Schema: .env.schema (Varlock). Regenerate types: bun run env:generate

NODE_ENV=development

# Min 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32-output

# Public app URL (Astro default port)
BETTER_AUTH_URL=http://localhost:4321

# Local SQLite via libsql file URL (Docker overrides to file:/data/local.db)
DATABASE_URL=file:../../.data/local.db
