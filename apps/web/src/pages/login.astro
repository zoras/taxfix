---
import BrandMark from "../components/BrandMark.astro";
import SignInForm from "../components/SignInForm.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Sign in" chrome="bare">
  <main class="flex min-h-screen flex-col items-center justify-center gap-8 px-4 py-12">
    <a href="/" class="flex flex-col items-center gap-3">
      <BrandMark class="size-12" />
      <span class="text-sm font-medium text-muted-foreground">
        This Month · Taxfix
      </span>
    </a>
    <div class="w-full max-w-md rounded-2xl border bg-card p-2 shadow-sm">
      <SignInForm />
    </div>
  </main>
</Layout>
