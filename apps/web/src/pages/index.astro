---
import Layout from "../layouts/Layout.astro";
---

<Layout title="This Month">
  <div class="mx-auto flex w-full max-w-2xl flex-1 flex-col justify-center gap-3">
    <p class="text-sm text-muted-foreground">September 2026</p>
    <h1 class="text-3xl font-medium tracking-tight">September is ready.</h1>
    <p class="max-w-md text-muted-foreground">
      A short check-in about your life this month. Nothing to catch up on unless you want to.
    </p>
  </div>
</Layout>
