---
interface Props {
  class?: string;
}

const { class: className = "size-10" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  role="img"
  aria-label="This Month"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="32" height="32" rx="10" fill="var(--color-brand-forest)"></rect>
  <path
    d="M9 16.8 13.9 21.5 23 11"
    stroke="var(--color-brand-lime)"
    stroke-width="3"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>
